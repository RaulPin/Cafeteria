generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  color    String    @default("#6B7280")
  products Product[]
}

model Product {
  id                 String              @id @default(cuid())
  name               String
  price              Float
  categoryId         String
  category           Category            @relation(fields: [categoryId], references: [id])
  stock              Float               @default(0)
  minStock           Float               @default(5)
  unit               String              @default("unidad")
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
}

model Table {
  id     String  @id @default(cuid())
  number Int
  type   String  @default("physical")
  active Boolean @default(true)
  orders Order[]

  @@unique([number, type])
}

model Order {
  id            String      @id @default(cuid())
  tableId       String
  table         Table       @relation(fields: [tableId], references: [id])
  status        String      @default("open")
  paymentMethod String?
  subtotal      Float       @default(0)
  total         Float       @default(0)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  closedAt      DateTime?
  items         OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Float
  price     Float
  notes     String?
  createdAt DateTime @default(now())
}

model InventoryMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  type      String
  quantity  Float
  reason    String?
  createdAt DateTime @default(now())
}

model Ingredient {
  id         String               @id @default(cuid())
  name       String               @unique
  category   String               @default("Otros")
  stock      Float                @default(0)
  minStock   Float                @default(1)
  unit       String               @default("litro")
  active     Boolean              @default(true)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  movements  IngredientMovement[]
}

model IngredientMovement {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  type         String
  quantity     Float
  reason       String?
  createdAt    DateTime   @default(now())
}

model CashRegisterCut {
  id                String   @id @default(cuid())
  date              DateTime @default(now())
  totalOrders       Int
  totalCash         Float
  totalCard         Float
  totalRevenue      Float
  totalExpenses     Float    @default(0)
  categoryBreakdown String
  createdAt         DateTime @default(now())
}

model Expense {
  id            String   @id @default(cuid())
  description   String
  amount        Float
  category      String   @default("Otros")
  paymentMethod String   @default("cash")
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
